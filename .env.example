# Supabase — online multiplayer storage, sync doorbell, and presence.
# Create a dedicated project (see SETUP.md), run supabase/schema.sql in its
# SQL editor, then copy these three values from that project's dashboard:
# Project Settings → API.

# Project URL — e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" API key — safe to expose to browsers; Row Level Security
# limits it to reads only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" API key — SERVER ONLY. Full database access; never expose
# it to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
